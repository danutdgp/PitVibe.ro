# URL-ul proiectului Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://proiectul-tau.supabase.co
# Cheia publică publishable/anon; poate fi folosită în browser și este protejată prin RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_exemplu
# Cheie secretă folosită exclusiv pe server pentru ștergerea contului; nu o prefixa cu NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_exemplu
# Local: http://localhost:3000 | Producție: https://pitivibe.ro
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Reclamele rămân oprite până la aprobarea AdSense și configurarea unei CMP certificate
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
